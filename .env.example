# Copy to .env in the repository root. The local launcher loads this file.
# Leave the local database profile for standalone development.
SPRING_PROFILES_ACTIVE=local
APP_PUBLIC_URL=http://127.0.0.1:5173

# Local email preview is available only to administrators at /admin/email-outbox.
# Set MAIL_MODE=smtp with your own SMTP account to send real emails.
MAIL_MODE=outbox
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@bidpro.local
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Razorpay test keys first. Secret values are used only by the backend.
PAYMENTS_ENABLED=false
PAYMENTS_LOCAL_TEST=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=false

# Optional MySQL profile: SPRING_PROFILES_ACTIVE=mysql
# DB_URL=jdbc:mysql://127.0.0.1:3306/bidpro
# DB_USERNAME=bidpro
# DB_PASSWORD=
# JWT_SECRET=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Production is a separate, fail-closed profile; see docs/operations.md first.
# SPRING_PROFILES_ACTIVE=production
# APP_PUBLIC_URL=https://your-auction-domain.example
# CORS_ORIGINS=https://your-auction-domain.example
# DB_URL=jdbc:mysql://your-db.example:3306/bidpro?sslMode=VERIFY_IDENTITY
# Production requires a provisioned schema, private JWT key and SMTP with verified TLS.

# Process-local abuse limits. A trusted gateway/shared limiter is needed across instances.
# APP_SECURITY_RATE_LIMIT_AUTH_PER_MINUTE=60
# APP_SECURITY_RATE_LIMIT_SIGNUP_PER_HOUR=30
# APP_SECURITY_RATE_LIMIT_RECOVERY_PER_HOUR=30
# APP_SECURITY_RATE_LIMIT_BID_PER_MINUTE=120

# Optional background settlement controls (manual settlement remains available).
# APP_AUCTIONS_SETTLEMENT_ENABLED=true
# APP_AUCTIONS_SETTLEMENT_POLL_MS=30000
